---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Sidan finns inte — Scandic Marketing"
  description="Sidan du letar efter finns inte. Gå tillbaka till startsidan."
>
  <Nav />
  <main class="nf">
    <p class="label">Fig. 404 — Utanför kartan</p>
    <h1 class="display">Den här höjden är inte uppmätt.</h1>
    <p class="text">Sidan du letar efter finns inte — men startsidan gör det.</p>
    <a class="cta" href={`${base}/`}>Till startsidan <span aria-hidden="true">→</span></a>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 70svh;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 10rem var(--gutter) 4rem;
  }
  h1 {
    font-size: clamp(2.2rem, 4.8vw, 3.8rem);
    margin-top: 2rem;
  }
  .text {
    margin-top: 1.2rem;
    color: var(--type-dim);
  }
  .cta {
    display: inline-block;
    margin-top: 2.2rem;
    padding: 0.85rem 1.5rem;
    background: var(--accent);
    color: var(--cta-text);
    font-family: var(--font);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }
</style>

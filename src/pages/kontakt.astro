---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Kontakta Scandic Marketing — Helsingborg"
  description="Kontakta Scandic Marketing i Helsingborg: kontakt@scandicmarketing.se, +46 76 929 85 01, Redaregatan 48. Vi svarar inom en arbetsdag."
>
  <Nav />
  <main class="kontakt-page">
    <!-- Sidan lånar Contact-sektionen, vars rubrik är en h2 eftersom den där
         sitter mitt i startsidans hierarki. Här är kontakt hela sidans ämne,
         så den behöver en egen h1 — dold, för att inte dubblera rubriken som
         redan står i sektionen. -->
    <h1 class="sr-only">Kontakta Scandic Marketing</h1>
    <Contact />
  </main>
  <Footer />
</Base>

<style>
  .kontakt-page {
    min-height: 72svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

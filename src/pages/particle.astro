---
/* Partikellabbet — en intern sida, inte en del av sajten.

   Tom yta, en formation per skärmhöjd. Scrolla, titta, säg vilka som ska
   in. Ingen nav, ingen footer, ingen text att läsa: bara fältet och ett
   litet namn i hörnet så man vet vad man tittar på.

   Sidan är noindex och länkas inte någonstans ifrån. Den ska bort — eller
   flyttas bakom lösenord — innan riktig lansering. */
import Base from '../layouts/Base.astro';
import { LAB } from '../scripts/lab/index';

// Produktionens egna formationer först, så de går att jämföra rakt av.
const house = [
  { name: 'logo', title: 'Logotypen', note: 'Märket självt, samplat ur logo.webp. Sajtens hjälte.' },
  { name: 'mark', title: 'Symbolen', note: 'Enbart bomärket, tätt och skarpt. Ligger i Kontakt.' },
  { name: 'bars', title: 'Staplar', note: 'Fem stigande staplar. Ligger i Resultat.' },
  { name: 'shapes', title: 'Play och hårkors', note: 'Två former som byts efter scrolldjup. Ligger i Tjänster.' },
  { name: 'wave', title: 'Dyning', note: 'Tre långsamma vågor över hela bredden. Ligger i brytsektionen.' },
  { name: 'steps', title: 'Stigande bana', note: 'Tre hållpunkter längs en kurva. Ligger i Så arbetar vi.' },
  { name: 'converge', title: 'Konvergens', note: 'Fyllotaxi-skiva. Låg i Kontakt tidigare, nu ledig.' },
  { name: 'drift', title: 'Fritt driv', note: 'Ingen formation alls — grundtillståndet bakom läsytor.' },
];
const all = [...house, ...LAB.map((f) => ({ name: f.name, title: f.title, note: f.note }))];
---

<Base
  title="Partikellabb — Scandic Marketing"
  description="Intern sida. Kandidater till partikelfältet."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <canvas class="field-canvas" id="field" aria-hidden="true"></canvas>

  <header class="bar">
    <span class="label">Partikellabb</span>
    <span class="label dim">{all.length} formationer — scrolla</span>
  </header>

  <main>
    {
      all.map((f, i) => (
        <section class="slot" data-field={f.name}>
          <div class="plate">
            <span class="label num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{f.title}</h2>
            <p class="note">{f.note}</p>
            <code class="tag">data-field="{f.name}"</code>
          </div>
        </section>
      ))
    }
    <section class="slot end" data-field="drift">
      <div class="plate">
        <h2>Slut</h2>
        <p class="note">Säg vilka nummer som ska in, så flyttar jag in dem i sajten.</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initField } from '../scripts/field';
  import { LAB } from '../scripts/lab/index';
  initField(document.getElementById('field') as HTMLCanvasElement, LAB);
</script>

<style>
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }
  .dim { color: var(--muted); }

  .slot {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  /* Plattan hålls smal och till vänster: formationerna ritas mitt i rutan
     och ska inte behöva samsas med text. */
  .plate {
    max-width: min(26rem, 42vw);
    margin-inline: auto 0;
    margin-left: max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
    padding: 1.4rem 0;
  }
  .num { color: var(--accent); }
  h2 {
    margin: 0.6rem 0 0.7rem;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .note {
    color: var(--type-dim);
    font-size: 0.95rem;
    max-width: 30ch;
  }
  .tag {
    display: inline-block;
    margin-top: 1.1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .end .plate { max-width: 30rem; }

  @media (max-width: 760px) {
    .plate { max-width: none; margin-inline: var(--gutter); }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Clients from '../components/Clients.astro';
import Results from '../components/Results.astro';
import Services from '../components/Services.astro';
import Break from '../components/Break.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Scandic Marketing',
  description:
    'Marknadsföringsbyrå i Helsingborg. Digital marknadsföring för företag i Skåne och Norden.',
  url: 'https://www.scandicmarketing.se',
  email: 'kontakt@scandicmarketing.se',
  telephone: '+46769298501',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Redaregatan 48',
    addressLocality: 'Helsingborg',
    addressCountry: 'SE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 56.0405, longitude: 12.6922 },
  openingHours: 'Mo-Fr 09:00-17:00',
  sameAs: ['https://www.instagram.com/scandicmarketing.se/'],
  areaServed: ['Helsingborg', 'Skåne', 'Sverige', 'Norden'],
};
---

<Base
  title="Scandic Marketing — Digital marknadsföring i Helsingborg"
  description="Scandic Marketing är en marknadsföringsbyrå i Helsingborg som arbetar med digital marknadsföring för företag i Skåne och Norden."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <canvas class="field-canvas" id="field" aria-hidden="true"></canvas>
  <Nav />
  <main>
    <Hero />
    <Clients />
    <Results />
    <Services />
    <Break />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import { initField } from '../scripts/field';
  initField(document.getElementById('field') as HTMLCanvasElement);
</script>

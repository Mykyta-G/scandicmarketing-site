---
import Sub from '../layouts/Sub.astro';

const rows = [
  {
    k: 'Reklamfilm',
    v: 'Kort, skarp film för annonsering och kampanjer — byggd för att stoppa tummen.',
  },
  {
    k: 'Företagsfilm',
    v: 'Berätta vad ni gör och varför det spelar roll. För hemsidan, mässan eller rekryteringen.',
  },
  {
    k: 'Sociala medier',
    v: 'Löpande innehåll i rätt format för varje kanal, levererat månad efter månad.',
  },
  {
    k: 'Event och drönare',
    v: 'Dokumentation av event, och flygbilder när perspektivet behöver lyfta.',
  },
];
---

<Sub
  title="Videoproduktion i Helsingborg — Scandic Marketing"
  description="Reklamfilm, företagsfilm och innehåll för sociala medier. Filmat i 4K med drönare, klippt och färgsatt. Fast offert innan vi startar."
  fig="03"
  figName="Videoproduktion"
  heading="Film som berättar vad ni bygger."
  sub="Från idé och manus till inspelning och efterproduktion. Filmat i 4K, med drönare när det behövs — klippt, färgsatt och färdigt att publicera."
>
  <section class="list">
    <div class="rows">
      {
        rows.map((r) => (
          <div class="row reveal">
            <h2 class="display">{r.k}</h2>
            <p>{r.v}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="how reveal">
    <p class="label">Så går det till</p>
    <p class="how-text">
      Vi börjar med ett kort samtal om vad filmen ska åstadkomma. Sedan får ni ett fast pris —
      de flesta produktioner börjar runt 5&nbsp;000&nbsp;kr, och ni vet alltid vad det kostar
      innan vi startar. Offert inom en arbetsdag.
    </p>
    <a class="cta" href="mailto:kontakt@scandicmarketing.se?subject=Videoproduktion"
      >Begär offert <span aria-hidden="true">→</span></a
    >
  </section>
</Sub>

<style>
  .list { padding-top: clamp(3rem, 7vh, 5rem); }
  .rows { border-top: 1px solid var(--hairline); max-width: 52rem; }
  .row {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2rem;
    padding: 1.9rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  h2 { font-size: clamp(1.35rem, 2vw, 1.7rem); }
  .row p { color: var(--bone-dim); font-size: 0.97rem; max-width: 34rem; }

  .how { padding: clamp(3rem, 7vh, 5rem) 0 clamp(4rem, 9vh, 7rem); }
  .how-text {
    margin-top: 1.2rem;
    max-width: var(--measure);
    color: var(--bone-dim);
  }
  .cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.85rem 1.5rem;
    background: var(--amber);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cta:hover { background: var(--amber-bright); }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>

---
/* Bokningssidan.

   Samma fält som ägarens nuvarande formulär, med två skillnader: tjänstevalet
   är borta (han säljer bara marknadsföring, så frågan hade bara ett svar) och
   sidan är byggd i sajtens eget formspråk i stället för mallens.

   OBS — INGEN SERVER: sajten är statisk. Formuläret öppnar därför besökarens
   e-postklient med allt ifyllt i brödtexten. Det är ärligt och fungerar
   överallt, men det är inte en riktig inlämning: ingen kvittens, inget
   register, och den som saknar e-postklient blir strandsatt (därför står
   adress och telefon synligt bredvid).

   Vill han ha riktig inlämning behövs en endpoint — Formspree, Netlify Forms
   eller en liten funktion. Byt då ut submit-hanteraren mot ett fetch-anrop;
   fälten heter redan samma sak som hans nuvarande formulär. */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

/* Tre korta löften i stället för tre stycken bredvid formuläret. Samma
   besked, en rad i stället för en vägg — och högerspalten blir fri. */
const promises = ['Svar inom en arbetsdag', 'Kostnadsfritt samtal', 'Ingen förpliktelse'];

const times = ['09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00'];
---

<Base
  title="Boka ett samtal — Scandic Marketing"
  description="Boka ett kostnadsfritt samtal med Scandic Marketing. Berätta vad ni vill uppnå, så hör vi av oss inom en arbetsdag."
>
  <canvas class="field-canvas" id="field" aria-hidden="true"></canvas>
  <Nav />

  <main class="book">
    <!-- Fältet ritar bara symbolen, och bara i högerspalten: ingen text
         ligger där, så den kan vara tät utan att göra något svårläst. -->
    <div class="inner" data-field="mark">
      <header class="intro">
        <h1 class="display dash split">Berätta vad ni vill uppnå.</h1>
      </header>

      <!-- Kvittensen ersätter formuläret på plats. Besökaren ska inte behöva
           lämna sidan eller gissa om förfrågan gick fram. -->
      <div class="form done" id="booking-done" hidden>
        <p class="tick" aria-hidden="true">✓</p>
        <h2 class="display">Tack — vi har din förfrågan.</h2>
        <p class="donetext">
          Vi hör av oss inom en arbetsdag med tid och plats. Brådskar det når
          du oss på <a href="tel:+46769298501">+46 76 929 85 01</a>.
        </p>
      </div>

      <form class="form reveal" id="booking-form" novalidate>
        <div class="row two">
          <p class="field">
            <label class="label" for="name">Namn <span class="req">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name"
              placeholder="Ditt fullständiga namn" />
          </p>
          <p class="field">
            <label class="label" for="email">E-post <span class="req">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email"
              placeholder="din@epost.se" />
          </p>
        </div>

        <div class="row two">
          <p class="field">
            <label class="label" for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel"
              placeholder="070-123 45 67" />
          </p>
          <p class="field">
            <label class="label" for="company">Företag</label>
            <input id="company" name="company" type="text" autocomplete="organization"
              placeholder="Ert företag" />
          </p>
        </div>

        <div class="row two">
          <p class="field">
            <label class="label" for="date">Önskat datum</label>
            <input id="date" name="preferredDate" type="date" />
          </p>
          <p class="field">
            <label class="label" for="time">Önskad tid</label>
            <select id="time" name="preferredTime">
              <option value="">Välj en tid</option>
              {times.map((t) => <option value={t}>{t}</option>)}
            </select>
          </p>
        </div>

        <p class="field">
          <label class="label" for="message">Berätta om ert projekt <span class="req">*</span></label>
          <textarea id="message" name="message" rows="3" required
            placeholder="Vad säljer ni, vem ska hitta er, och vad räknas som resultat?"></textarea>
        </p>

        <!-- Skräpfälla: fältet är dolt och tomt för människor. Fyller en bot i
             det låtsas vi att allt gick bra utan att skicka något — en bot som
             får ett felmeddelande försöker igen, en som får kvittens går
             vidare. Bokningarna landar bara i en inkorg, så skräp är inte
             bara irriterande: det kan dränka en riktig förfrågan. -->
        <p class="trap" aria-hidden="true">
          <label for="company_url">Lämna detta fält tomt</label>
          <input id="company_url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
        </p>

        <div class="send">
          <button class="cta" type="submit">Skicka förfrågan <span aria-hidden="true">→</span></button>
          <p class="note" id="form-note" role="status" aria-live="polite"></p>
        </div>

        <p class="consent">
          Uppgifterna används bara för att svara på din förfrågan. Läs mer i
          <a href={`${base}/integritetspolicy`}>integritetspolicyn</a>.
        </p>

        <ul class="promises" aria-label="Vad som gäller">
          {promises.map((t) => <li class="label">{t}</li>)}
        </ul>

        <p class="direct-line">
          <span class="label">Hellre direkt?</span>
          <a href="mailto:kontakt@scandicmarketing.se">kontakt@scandicmarketing.se</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href="tel:+46769298501">+46 76 929 85 01</a>
        </p>
      </form>

      <!-- Tom med flit: symbolen bor här. -->
      <aside class="aside" aria-hidden="true"></aside>
    </div>
  </main>

  <!-- Ingen fullstor sidfot: det här är en uppgiftssida som ska rymmas i en
       skärm. Det juridiska ligger i en smal remsa i stället. -->
  <div class="legal">
    <span>© 2026 Scandic Marketing</span>
    <span class="links">
      <a href={`${base}/`}>Startsidan</a>
      <a href={`${base}/integritetspolicy`}>Integritetspolicy</a>
      <a href={`${base}/anvandarvillkor`}>Användarvillkor</a>
    </span>
  </div>
</Base>

<script>
  import { initField } from '../scripts/field';
  initField(document.getElementById('field') as HTMLCanvasElement);
</script>

<script>
  /* Inlämning.

     I första hand postas formuläret till samma Supabase-funktion som ägarens
     nuvarande sajt använder: besökaren stannar kvar och får en kvittens.

     Saknas konfigurationen faller vi tillbaka på att öppna e-postklienten
     med allt ifyllt. Sämre — ingen kvittens, inget register — men det
     fungerar överallt, och en knapp som inte gör något vore värre. */
  import { SUPABASE_URL, SUPABASE_ANON_KEY, BOOKING_FN, SERVICE, canPost } from '../config/booking';

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const doneEl = document.getElementById('booking-done');
  const note = document.getElementById('form-note');
  const btn = form?.querySelector('button[type=submit]') as HTMLButtonElement | null;

  if (note) {
    note.textContent = canPost
      ? ''
      : 'Knappen öppnar din e-post med uppgifterna ifyllda.';
  }

  const values = (f: HTMLFormElement) => {
    const o: Record<string, string> = { service: SERVICE };
    for (const [k, v] of new FormData(f).entries()) o[k] = String(v).trim();
    return o;
  };

  const mailto = (v: Record<string, string>) => {
    const rows = [
      `Namn: ${v.name}`,
      `E-post: ${v.email}`,
      v.phone && `Telefon: ${v.phone}`,
      v.company && `Företag: ${v.company}`,
      v.preferredDate && `Önskat datum: ${v.preferredDate}`,
      v.preferredTime && `Önskad tid: ${v.preferredTime}`,
      '',
      'Om projektet:',
      v.message,
    ].filter(Boolean);
    location.href =
      'mailto:kontakt@scandicmarketing.se' +
      `?subject=${encodeURIComponent('Bokningsförfrågan — ' + (v.company || v.name))}` +
      `&body=${encodeURIComponent(rows.join('\n'))}`;
  };

  const succeed = () => {
    form?.setAttribute('hidden', '');
    doneEl?.removeAttribute('hidden');
    doneEl?.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const v = values(form);

    /* Skräpfällan slog till. Samma kvittens som en riktig bokning får — en bot
       som märker att den blockeras byter bara taktik. Inget skickas. */
    if (v.company_url) { succeed(); return; }
    delete v.company_url;

    if (!canPost) { mailto(v); return; }

    btn?.setAttribute('disabled', '');
    const label = btn?.textContent ?? '';
    if (btn) btn.textContent = 'Skickar…';
    if (note) note.textContent = '';

    try {
      const res = await fetch(`${SUPABASE_URL}/functions/v1/${BOOKING_FN}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify(v),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      succeed();
    } catch (err) {
      /* Ingen alert-ruta: den blockerar sidan och säger inget om vad man gör
         nu. Felet står kvar i formuläret med en väg vidare — och mejlvägen
         som reserv, så förfrågan inte går förlorad. */
      if (note) {
        note.innerHTML =
          'Det gick inte att skicka just nu. ' +
          '<button type="button" class="linkish" id="fallback">Skicka som e-post i stället</button>' +
          ' eller ring +46 76 929 85 01.';
        note.classList.add('is-error');
        document.getElementById('fallback')?.addEventListener('click', () => mailto(v));
      }
      console.error('Bokning misslyckades:', err);
    } finally {
      btn?.removeAttribute('disabled');
      if (btn && label) btn.textContent = label;
    }
  });
</script>

<style>
  /* Sidan ska rymmas i en skärm på en vanlig laptop: rubrik och formulär i
     vänsterspalten, kontakt och stegen i högerspalten bredvid. Klarar den
     inte höjden (kort fönster, stor text) scrollar den som vanligt — inget
     är klippt, bara tätare. */
  .book {
    /* Naven är fixerad och ligger över innehållet — därför en egen övre
       marginal här i stället för att lita på flödet. */
    --nav-h: 4.6rem;
    min-height: calc(100svh - 3rem); /* 3rem = den smala remsan nedanför */
    display: flex;
    align-items: center;
    padding: calc(var(--nav-h) + clamp(0.5rem, 2vh, 1.5rem)) 0 clamp(1.5rem, 4vh, 3rem);
  }
  .inner {
    max-width: var(--page-max);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.8fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 4vw, 3.5rem);
    row-gap: clamp(1.2rem, 3vh, 2rem);
    align-items: start;
  }

  .intro { grid-column: 1; grid-row: 1; }
  .form { grid-column: 1; grid-row: 2; }
  .aside { grid-column: 2; grid-row: 1 / span 2; }

  h1 {
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    max-width: 15ch;
  }

  /* ————— Formuläret ————— */
  .form {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    padding: clamp(1.2rem, 2.4vw, 1.8rem);
  }
  .row.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .field { margin: 0 0 0.85rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .req { color: var(--accent); }

  input, select, textarea {
    font: inherit;
    font-size: 0.97rem;
    color: var(--navy);
    background: var(--ground);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    padding: 0.62rem 0.8rem;
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea { resize: vertical; min-height: 5.2rem; line-height: 1.5; }
  input::placeholder, textarea::placeholder { color: var(--muted); opacity: 0.8; }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
  }
  input:invalid:not(:placeholder-shown) { border-color: #b42318; }

  .send {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }
  .cta {
    flex: none;
    padding: 0.8rem 1.4rem;
    background: var(--accent);
    color: var(--cta-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 0;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: background 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s;
  }
  .cta:hover { background: var(--accent-strong); box-shadow: var(--shadow-medium); }
  /* Skräpfällan: borta för ögat och för skärmläsaren, men ifyllbar för en bot
     som läser markupen. Därför inte display:none — en del bottar hoppar över
     fält som är helt borttagna ur layouten. */
  .trap {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .consent {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    max-width: 44ch;
  }
  .consent a { color: var(--accent); }

  .note { margin: 0; color: var(--type-dim); font-size: 0.84rem; max-width: 24rem; }
  .note:empty { display: none; }
  .note.is-error { color: #b42318; }
  .linkish {
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  /* Kvittensen */
  .done { text-align: center; padding: clamp(2.4rem, 6vw, 4rem) clamp(1.2rem, 3vw, 2rem); }
  .tick {
    margin: 0 auto 1.1rem;
    width: 3rem; height: 3rem;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--cta-text);
    font-size: 1.5rem;
  }
  .done h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; }
  .donetext { margin: 0.8rem auto 0; max-width: 32ch; color: var(--type-dim); font-size: 0.97rem; }
  .donetext a { color: var(--accent); }

  .direct-line {
    margin: 0.9rem 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.7rem;
    font-size: 0.94rem;
    color: var(--type-dim);
  }
  .direct-line a { color: var(--navy); text-decoration: none; transition: color 0.2s; }
  .direct-line a:hover { color: var(--accent); }
  .sep { color: var(--hairline-strong); }

  .promises {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    color: var(--muted);
  }
  .promises li { display: flex; align-items: center; gap: 0.5rem; }
  .promises li::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .legal {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    color: var(--muted);
    font-size: 0.76rem;
  }
  .legal .links { display: flex; gap: 1.2rem; }
  .legal a { color: var(--muted); text-decoration: none; }
  .legal a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    /* En spalt, och formuläret först — det ÄR sidan. */
    .book { min-height: 0; display: block; }
    .inner { grid-template-columns: 1fr; }
    .intro, .form, .aside { grid-column: 1; grid-row: auto; }
    /* Symbolen ritas i en fast canvas bakom innehållet — spalten behöver
       ingen egen yta på smalt. */
    .aside { display: none; }
  }
  @media (max-width: 560px) {
    .row.two { grid-template-columns: 1fr; gap: 0; }
  }
</style>

---
/* Partikelfältet ritar ägarens egen symbol till höger om uppgifterna
   (data-field="mark") — tätare och skarpare än den gamla sfären, som var
   en generisk form utan avsändare. */
---
<section class="contact" id="kontakt" data-field="mark">
  <div class="inner">
    <p class="label section-label reveal">05 — Kontakt</p>
    <h2 class="display dash split">Berätta vad ni vill bygga.</h2>

    <div class="rows reveal">
      <a class="row" href="mailto:kontakt@scandicmarketing.se">
        <span class="label k">E-post</span>
        <span class="v">kontakt@scandicmarketing.se</span>
      </a>
      <a class="row" href="tel:+46769298501">
        <span class="label k">Telefon</span>
        <span class="v">+46 76 929 85 01</span>
      </a>
      <div class="row">
        <span class="label k">Kontor</span>
        <span class="v">Redaregatan 48, Helsingborg</span>
      </div>
      <div class="row">
        <span class="label k">Öppet</span>
        <span class="v">Vardagar 09–17</span>
      </div>
    </div>

    <a class="cta reveal" href="mailto:kontakt@scandicmarketing.se?subject=Boka%20ett%20samtal"
      >Boka ett samtal <span aria-hidden="true">→</span></a
    >
  </div>
</section>

<style>
  .contact {
    padding: clamp(5rem, 14vh, 10rem) 0 clamp(4rem, 10vh, 7rem);
  }
  .inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-label { margin-bottom: 2.5rem; }

  h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
    max-width: 14em;
    margin-bottom: 3rem;
  }

  .rows {
    border-top: 1px solid var(--hairline);
    max-width: min(44rem, 60%);
  }
  @media (max-width: 900px) {
    .rows { max-width: 44rem; }
  }
  .row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 2rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
  }
  .v { color: var(--navy); font-size: 1.05rem; transition: color 0.2s; }
  a.row:hover .v { color: var(--accent); }

  .cta {
    display: inline-block;
    margin-top: 2.6rem;
    padding: 0.85rem 1.5rem;
    background: var(--accent);
    color: var(--cta-text);
    font-family: var(--font);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    transition: background 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cta:hover { background: var(--accent-strong); }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>

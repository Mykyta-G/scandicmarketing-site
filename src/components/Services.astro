---
/* Kortens bilder är hämtade från ägarens nuvarande sajt (hans val av bildspråk).
   OBS före lansering: verifiera licensen för dessa bilder (troligen stockbilder
   han köpt/laddat ner) — byts helst mot riktiga produktionsstillbilder. */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const services = [
  {
    n: '01',
    name: 'Film',
    text: 'Reklamfilm, företagsfilm och innehåll för sociala medier — filmat i 4K, färdigt att publicera.',
    href: `${base}/videoproduktion`,
    img: `${base}/img/service-film.webp`,
    pos: '50% 50%',
  },
  {
    n: '02',
    name: 'Foto',
    text: 'Företagsporträtt, produktbilder, mat och miljöer — retuscherat och levererat för webb och tryck.',
    href: `${base}/fotografi`,
    img: `${base}/img/service-foto.webp`,
    pos: '50% 50%',
  },
  {
    n: '03',
    name: 'Hemsidor',
    text: 'Snabba, sökmotorvänliga hemsidor till fast månadspris — domän och underhåll ingår.',
    href: `${base}/hemsida`,
    img: `${base}/img/service-hemsidor.webp`,
    pos: '50% 50%',
  },
  {
    n: '04',
    name: 'Marknadsföring',
    text: 'SEO, annonsering och sociala medier — med resultat som mäts mot verkliga siffror.',
    href: '#kontakt',
    img: `${base}/img/service-marknad.webp`,
    pos: '50% 50%',
  },
];
---

<section class="services" id="tjanster">
  <div class="inner">
    <p class="label section-label reveal">02 — Tjänster</p>
    <div class="grid">
      {
        services.map((s) => (
          <a class="card reveal" href={s.href}>
            <img src={s.img} alt="" loading="lazy" width="900" height="1050" style={`object-position:${s.pos}`} />
            <div class="shade" aria-hidden="true"></div>
            <span class="label n">{s.n}</span>
            <div class="body">
              <h3 class="display">{s.name}</h3>
              <p class="text">{s.text}</p>
              <span class="go label" aria-hidden="true">Läs mer →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: clamp(5rem, 12vh, 9rem) 0 clamp(3rem, 7vh, 5rem);
  }
  .inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-label { margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }

  .card {
    position: relative;
    aspect-ratio: 3 / 4.1;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    isolation: isolate;
    outline: 1px solid var(--hairline);
    outline-offset: -1px;
  }
  .card img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.78) contrast(1.05) saturate(0.85);
    transition: scale 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.7s;
  }
  .card:hover img {
    scale: 1.045;
    filter: brightness(0.9) contrast(1.05) saturate(0.95);
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(19, 21, 23, 0.88) 0%, rgba(19, 21, 23, 0.25) 45%, transparent 70%);
  }

  .n {
    position: absolute;
    top: 1.1rem;
    left: 1.2rem;
    color: var(--on-photo);
    opacity: 0.75;
  }

  .body {
    padding: 1.2rem 1.2rem 1.3rem;
  }
  h3 {
    color: var(--on-photo);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }
  .text {
    margin-top: 0.55rem;
    color: rgba(233, 230, 224, 0.78);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .go {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--amber);
    opacity: 0;
    translate: -6px 0;
    transition: opacity 0.3s, translate 0.3s;
  }
  .card:hover .go { opacity: 1; translate: 0 0; }

  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .grid { grid-template-columns: 1fr; }
    .card { aspect-ratio: 4 / 3; }
    .go { opacity: 1; translate: 0 0; }
  }
</style>

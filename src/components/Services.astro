---
/* En enda tjänst: marknadsföring — ingenting annat.
   Ägaren säljer inte film, foto eller hemsidor, och inte heller SEO,
   annonsering eller sociala medier som separata poster; hans gamla sajt
   listar sådant felaktigt. Därför står här bara erbjudandet.
   ATT FYLLA PÅ: vad marknadsföringen konkret innebär måste komma från
   ägaren själv — hitta inte på det. */
---

<section class="services" id="tjanster" data-field="shapes">
  <div class="inner">
    <p class="label section-label reveal">02 — Tjänster</p>

    <div class="offer">
      <h2 class="display dash reveal">Digital marknadsföring<span class="dot">.</span></h2>
      <p class="lead reveal">
        Det är vad vi gör — och det enda vi gör. Marknadsföring med resultat
        som mäts mot verkliga siffror.
      </p>
      <a class="cta reveal" href="#kontakt">Boka ett samtal <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .services {
    padding: clamp(5rem, 12vh, 9rem) 0 clamp(3rem, 7vh, 5rem);
  }
  .inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-label { margin-bottom: 2.5rem; }

  .offer h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
    max-width: 16ch;
  }
  .dot { color: var(--accent); }
  .lead {
    margin-top: 1.4rem;
    max-width: var(--measure);
    color: var(--type-dim);
    font-size: 1.1rem;
  }

  .cta {
    display: inline-block;
    margin-top: 2.2rem;
    padding: 0.85rem 1.5rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: background 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s, translate 0.3s;
  }
  .cta:hover {
    background: var(--accent-deep, #1d4ed8);
    box-shadow: var(--shadow-medium);
    translate: 0 -2px;
  }
</style>

---
/* Ett kort, en tjänst: marknadsföring. Bildkortet är samma bildspråk som
   ägarens nuvarande sajt använder (service-marknad.webp är hans egen bild
   från marknadsföringskortet).

   Ägaren säljer inte film, foto eller hemsidor, och inte heller SEO,
   annonsering eller sociala medier som egna poster — därför bara ett kort.

   Kortet ligger i vänsterspalten; högerspalten är tom med flit eftersom
   partikelformationen bor där och inte ska täckas.

   OBS före lansering: verifiera licensen för bilden (troligen en stockbild
   han köpt/laddat ner) — byts helst mot en riktig bild från hans arbete. */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section class="services" id="tjanster" data-field="shapes">
  <div class="inner">
    <p class="label section-label reveal">02 — Tjänster</p>

    <div class="cols">
      <div class="left">
        <div class="offer">
          <h2 class="display dash reveal">Digital marknadsföring<span class="dot">.</span></h2>
          <p class="lead reveal">
            En byrå, en tjänst — med resultat som mäts mot verkliga siffror.
          </p>
        </div>

        <a class="card reveal reveal-clip" href="#kontakt">
          <img
            src={`${base}/img/service-marknad.webp`}
            alt=""
            loading="lazy"
            width="900"
            height="700"
          />
          <div class="shade" aria-hidden="true"></div>
          <span class="label n">01</span>
          <div class="body">
            <h3 class="display">Marknadsföring<span class="dot">.</span></h3>
            <p class="text">
              Vi tar hand om marknadsföringen åt er — från plan till
              genomförande och uppföljning, löpande månad för månad.
            </p>
            <span class="go label" aria-hidden="true">Boka ett samtal →</span>
          </div>
        </a>
      </div>

      <!-- Tom med flit: partikelformationen bor här. -->
      <div class="right" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .services {
    padding: clamp(5rem, 12vh, 9rem) 0 clamp(3rem, 7vh, 5rem);
  }
  .inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-label { margin-bottom: 2.5rem; }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .right { min-height: 24rem; }

  .offer h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
    max-width: 16ch;
  }
  .dot { color: var(--accent); }
  .lead {
    margin-top: 1.4rem;
    max-width: var(--measure);
    color: var(--type-dim);
    font-size: 1.1rem;
  }

  .card {
    position: relative;
    display: flex;
    align-items: flex-end;
    margin-top: clamp(2.2rem, 5vh, 3.2rem);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-medium);
    transition: box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1), translate 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .card:hover { box-shadow: var(--shadow-large); translate: 0 -4px; }

  .card img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.68) contrast(1.05) saturate(0.85);
    transition: scale 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.7s;
  }
  .card:hover img {
    scale: 1.04;
    filter: brightness(0.8) contrast(1.05) saturate(0.95);
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(4, 18, 43, 0.94) 0%, rgba(4, 18, 43, 0.45) 48%, rgba(4, 18, 43, 0.12) 78%);
  }

  .n {
    position: absolute;
    top: 1.3rem;
    left: 1.5rem;
    color: #eef2f7;
    opacity: 0.8;
  }

  .body { padding: clamp(1.4rem, 3vw, 2rem); }
  h3 {
    color: #ffffff;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .card .dot { color: var(--accent-tint); }
  .text {
    margin-top: 0.7rem;
    max-width: 32rem;
    color: rgba(238, 242, 247, 0.88);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .go {
    display: inline-block;
    margin-top: 1.2rem;
    color: #93c5fd; /* ljus brandblå — ligger på mörkt foto, inte på vit mark */
    opacity: 0;
    translate: -6px 0;
    transition: opacity 0.3s, translate 0.3s;
  }
  .card:hover .go { opacity: 1; translate: 0 0; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; }
    /* Ingen reserverad yta på smalt: formationen ritas ändå i fast canvas
       bakom innehållet, och en tom platshållare blev bara ett hål. */
    .right { display: none; }
    .go { opacity: 1; translate: 0 0; }
  }
</style>

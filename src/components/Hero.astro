---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<div class="hero-pin">
  <section class="hero" data-field="logo">
    <div class="hero-content" id="hero-content">
      <p class="label kicker l0"><span class="tick" aria-hidden="true"></span>Marknadsföringsbyrå — Norden</p>

      <!-- Rubriken finns kvar för sök och skärmläsare; partikelfältet är den synliga titeln. -->
      <h1 class="sr-only">Scandic Marketing</h1>

      <!-- Hjältens titel ÄR logotypen. Partiklarna samplas ur exakt samma fil
           och lägger sig i den här rutan — bilden är måttstocken, inte en
           ungefärlig återgivning i Inter. Syns utan JS och tills fältet
           tagit över; bredd/höjd är satta så rutan står stilla medan den laddar. -->
      <div class="wm" id="wm" aria-hidden="true">
        <img src={`${base}/img/logo.webp`} alt="" width="480" height="159" fetchpriority="high" />
      </div>

      <p class="sub l2">
        Digital marknadsföring som går att mäta —
        i&nbsp;hela Norden.
      </p>
      <div class="actions l3">
        <a class="cta" href="#kontakt">Boka ett samtal <span aria-hidden="true">→</span></a>
        <a class="ghost label" href="#tjanster">Se våra tjänster <span class="bounce" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>
</div>

<script>
  // Pinned hero: the content fades, lifts and scales away while the next
  // section scrolls up over it. Plain rAF — works in every browser.
  const content = document.getElementById('hero-content');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (content && !reduced) {
    let ticking = false;
    const update = () => {
      // innehållet är borta INNAN nästa sektion glider in över den klistrade
      // hjälten — annars ligger två textlager över varandra på vit mark
      const p = Math.min(Math.max(scrollY / (innerHeight * 0.85), 0), 1);
      content.style.opacity = String(1 - p * 1.8);
      content.style.translate = `0 ${p * -7}vh`;
      content.style.scale = String(1 - p * 0.04);
      content.style.visibility = p >= 0.6 ? 'hidden' : 'visible';
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }
</script>

<style>
  .hero-pin { height: 150svh; }
  .hero {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    align-items: center;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pin { height: auto; }
    .hero { position: relative; }
  }

  /* En optisk kolumn, centrerad: kicker → ordmärke → undertext → CTA.
     Partiklarna ritar titeln; allt annat är satt kring den. */
  .hero-content {
    position: relative;
    max-width: var(--page-max);
    width: 100%;
    margin-inline: auto;
    padding: clamp(5rem, 12vh, 8rem) var(--gutter) clamp(2.5rem, 6vh, 4rem);
    text-align: center;
    will-change: opacity, translate, scale;
  }

  .kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    color: var(--muted);
    margin-bottom: clamp(1.6rem, 4vh, 2.6rem);
  }
  .tick {
    display: inline-block;
    width: 2rem;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    animation: draw 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes draw {
    from { width: 0; }
    to { width: 2rem; }
  }

  /* Logotypens plats: samma slot i hierarkin som rubriken hade.
     Utan JS är bilden hjältens titel; med JS ritas samma form av partiklarna. */
  .wm {
    width: min(56rem, 88vw);
    margin-inline: auto;
  }
  .wm img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sub {
    margin-top: clamp(1.5rem, 4vh, 2.4rem);
    margin-inline: auto;
    max-width: var(--measure);
    color: var(--type-dim);
    text-wrap: balance;
  }

  .actions {
    margin-top: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .ghost {
    color: var(--type-dim);
    text-decoration: none;
    transition: color 0.2s;
  }
  .ghost:hover { color: var(--accent-strong); }
  .bounce {
    display: inline-block;
    animation: bounce 1.8s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { translate: 0 0; }
    30% { translate: 0 -4px; }
    60% { translate: 0 2px; }
  }

  .cta {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: var(--accent);
    color: var(--cta-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    transition: background 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cta:hover { background: var(--accent-strong); box-shadow: var(--shadow-medium); }

  .l0, .l2, .l3 {
    opacity: 0;
    translate: 0 24px;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .l2 { animation-delay: 0.22s; }
  .l3 { animation-delay: 0.34s; }
  @keyframes rise {
    to { opacity: 1; translate: 0 0; }
  }

  /* Efter .l0/.l2/.l3 i kaskaden: intro-koreografin är avstängd globalt
     under reducerad rörelse — innehållet ska ändå synas. */
  @media (prefers-reduced-motion: reduce) {
    .l0, .l2, .l3 { opacity: 1; translate: none; }
  }
</style>

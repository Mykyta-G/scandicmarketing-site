---
const faqs = [
  {
    q: 'Vad gör Scandic Marketing?',
    a: 'Scandic Marketing är en marknadsföringsbyrå i Helsingborg. Vi arbetar med digital marknadsföring för företag i Skåne och övriga Norden.',
  },
  {
    q: 'Vad kostar marknadsföring?',
    a: 'Det beror på omfattningen, så vi lämnar offert efter ett kort samtal. Ni får alltid ett fast pris innan vi startar.',
  },
  {
    q: 'Var håller ni till?',
    a: 'På Redaregatan 48 i Helsingborg. Vi arbetar i hela Skåne och tar uppdrag i resten av Norden.',
  },
  {
    q: 'Hur snabbt får jag svar?',
    a: 'Vi svarar på förfrågningar inom en arbetsdag, vardagar 9–17.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="faq" id="fragor" data-field="braid">
  <div class="inner">
    <p class="label section-label reveal">04 — Vanliga frågor</p>
    <div class="list" data-stagger>
      {
        faqs.map((f) => (
          <details class="reveal">
            <summary>
              <span class="q display">{f.q}</span>
              <span class="mark" aria-hidden="true">+</span>
            </summary>
            <p class="a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .faq { padding: clamp(4rem, 10vh, 7rem) 0; }
  .inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-label { margin-bottom: 2.5rem; }

  .list {
    max-width: 52rem;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 0.4rem 1.8rem;
  }
  details { border-bottom: 1px solid var(--hairline); }
  details:last-child { border-bottom: none; }
  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .q { font-size: clamp(1.15rem, 1.8vw, 1.45rem); }
  .mark {
    font-family: var(--font);
    color: var(--muted);
    transition: rotate 0.25s, color 0.25s;
  }
  details[open] .mark { rotate: 45deg; color: var(--accent); }
  summary:hover .mark { color: var(--accent); }
  .a {
    color: var(--type-dim);
    font-size: 0.97rem;
    max-width: var(--measure);
    padding: 0 0 1.6rem;
  }
</style>
